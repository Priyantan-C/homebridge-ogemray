{
  "name": "homebridge-ogemray",
  "displayName": "Homebridge Ogemray",
  "version": "0.0.1",
  "description": "HomeKit support for Ogemray-based Wi-Fi switches (Tata Power EZ Home and other rebrands) via local LAN control — zero-config discovery, no cloud.",
  "license": "MIT",
  "author": "Priyantan-C",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Priyantan-C/homebridge-ogemray.git"
  },
  "bugs": {
    "url": "https://github.com/Priyantan-C/homebridge-ogemray/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "homebridge": ">=1.6.0 || ^2.0.0-beta.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "clean": "rimraf ./dist",
    "build": "rimraf ./dist && tsc",
    "test": "node --test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "homebridge-plugin",
    "ogemray",
    "tata-power-ez-home",
    "smart-switch",
    "local",
    "homekit"
  ],
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "homebridge": "^1.8.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.5.0"
  }
}
